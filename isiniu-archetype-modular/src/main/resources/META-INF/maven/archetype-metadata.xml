<?xml version="1.0" encoding="UTF-8"?>
<archetype-descriptor
        xmlns="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0 https://maven.apache.org/xsd/archetype-descriptor-1.1.0.xsd"
        name="isiniu-modular">
    <requiredProperties>
        <requiredProperty key="author">
            <defaultValue>isiniu</defaultValue>
        </requiredProperty>
        <requiredProperty key="errorCodePrefix">
            <defaultValue>APP</defaultValue>
        </requiredProperty>
        <requiredProperty key="isiniuParentVersion">
            <defaultValue>1.0.0-SNAPSHOT</defaultValue>
        </requiredProperty>
        <requiredProperty key="dollar">
            <defaultValue>$</defaultValue>
        </requiredProperty>
    </requiredProperties>
    <fileSets>
        <fileSet filtered="true" packaged="false" encoding="UTF-8">
            <directory></directory>
            <includes>
                <include>**/*</include>
                <include>**/.gitignore</include>
                <include>.gitignore</include>
            </includes>
        </fileSet>
    </fileSets>
</archetype-descriptor>
