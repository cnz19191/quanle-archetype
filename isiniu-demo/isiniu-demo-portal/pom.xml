<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.isiniu</groupId>
        <artifactId>isiniu-demo</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>isiniu-demo-portal</artifactId>
    <name>isiniu-demo-portal</name>
    <description>面向前端的跨领域聚合。编译期只依赖领域 api，不依赖领域实现。</description>

    <dependencies>
        <dependency>
            <groupId>com.isiniu</groupId>
            <artifactId>isiniu-demo-kernel</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.isiniu</groupId>
            <artifactId>isiniu-demo-issue-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-domain-impl</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <!-- 业务模块不依赖 Spring Security，只通过 LoginUserHolder 取用户 -->
                                        <exclude>com.isiniu:isiniu-common-auth</exclude>
                                        <exclude>org.springframework.security:*</exclude>
                                        <exclude>com.isiniu:isiniu-demo-issue</exclude>
                                        <exclude>com.isiniu:isiniu-demo-comment</exclude>
                                        <exclude>com.isiniu:isiniu-demo-auth</exclude>
                                        <exclude>com.isiniu:isiniu-demo-web</exclude>
                                        <exclude>com.isiniu:isiniu-demo-bootstrap</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
