<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.isiniu</groupId>
        <artifactId>isiniu-demo</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>isiniu-demo-web</artifactId>
    <name>isiniu-demo-web</name>
    <description>Web 公共配置：异步线程池、健康检查。鉴权和跨域由 isiniu-common 自动配置提供。</description>

    <dependencies>
        <dependency>
            <groupId>com.isiniu</groupId>
            <artifactId>isiniu-demo-kernel</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-domain-modules</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <!-- 业务模块不依赖 Spring Security，只通过 LoginUserHolder 取用户 -->
                                        <exclude>com.isiniu:isiniu-common-auth</exclude>
                                        <exclude>org.springframework.security:*</exclude>
                                        <exclude>com.isiniu:isiniu-demo-portal</exclude>
                                        <exclude>com.isiniu:isiniu-demo-bootstrap</exclude>
                                        <exclude>com.isiniu:isiniu-demo-auth</exclude>
                                        <exclude>com.isiniu:isiniu-demo-auth-api</exclude>
                                        <exclude>com.isiniu:isiniu-demo-issue</exclude>
                                        <exclude>com.isiniu:isiniu-demo-issue-api</exclude>
                                        <exclude>com.isiniu:isiniu-demo-comment</exclude>
                                        <exclude>com.isiniu:isiniu-demo-comment-api</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
