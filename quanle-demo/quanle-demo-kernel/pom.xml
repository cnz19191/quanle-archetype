<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.quanle</groupId>
        <artifactId>quanle-demo</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>quanle-demo-kernel</artifactId>
    <name>quanle-demo-kernel</name>
    <description>项目内核：错误码号段。不依赖任何领域模块。</description>

    <dependencies>
        <dependency>
            <groupId>com.quanle</groupId>
            <artifactId>quanle-common</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-upper-modules</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>com.quanle:quanle-demo-web</exclude>
                                        <exclude>com.quanle:quanle-demo-portal</exclude>
                                        <exclude>com.quanle:quanle-demo-bootstrap</exclude>
                                        <exclude>com.quanle:quanle-demo-issue</exclude>
                                        <exclude>com.quanle:quanle-demo-issue-api</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
